<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btndrawer"
        android:textColor="@color/white"
        android:background="@color/blue"
        android:text="btn"
        android:layout_marginTop="25dp"/>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_tausi"
        android:gravity="center"
        android:textStyle="bold"
        android:id="@+id/tvwelcome"
        android:textSize="27sp"
        android:layout_marginTop="20sp"
        android:layout_below="@id/btndrawer"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MISSION"
        android:id="@+id/tvMission"
        android:layout_below="@id/tvwelcome"
        android:gravity="center"
       android:layout_marginTop="60sp"
        android:textStyle="bold"
        android:textSize="23sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mission"
        android:gravity="center"
        android:textStyle="bold"
        android:id="@+id/tvmission"
        android:layout_below="@id/tvMission"
        android:layout_marginTop="30dp"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:textSize="18sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VISION"
        android:id="@+id/tvVision"
        android:layout_below="@id/tvmission"
        android:gravity="center"
        android:layout_marginTop="30sp"
        android:textStyle="bold"
        android:textSize="23sp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vision"
        android:gravity="center"
        android:textStyle="bold"
        android:id="@+id/tvvision"
        android:layout_below="@id/tvmission"
        android:layout_marginTop="80sp"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:textSize="18sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CORE VALUES"
        android:id="@+id/tvCorevalues"
        android:layout_below="@id/tvvision"
        android:gravity="center"
       android:layout_marginTop="30sp"
        android:textStyle="bold"
        android:textSize="23sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/core_values"
        android:gravity="center"
        android:textStyle="bold"
        android:id="@+id/tvcorevalues"
        android:layout_below="@id/tvvision"
        android:layout_marginTop="80sp"
        android:layout_marginStart="25sp"
        android:layout_marginEnd="25sp"
        android:textSize="18sp"
        />
    </RelativeLayout>



</androidx.drawerlayout.widget.DrawerLayout>